<Window x:Class="GrimDawnCompanion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GrimDawnCompanion.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="GDCompanion" Width="1380" Height="860" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackground}"
        WindowStyle="None" ResizeMode="CanResize" StateChanged="WindowStateChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#0B1525" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <Image Source="/GDCompanion;component/Assets/WardenLantern-titlebar.png" Width="27" Height="27" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="GDCompanion" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="RadarStatusButton" Click="ToggleNavigationMarkers"
                IsEnabled="{Binding IsEnabled, ElementName=NavigationToggleButton}"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                automation:AutomationProperties.Name="{Binding Text, ElementName=RadarIndicatorText}"
                ToolTipService.ShowOnDisabled="True" Margin="0,0,8,0" VerticalAlignment="Center">
          <Button.Style>
            <Style TargetType="Button">
              <Setter Property="Background" Value="{StaticResource PanelRaised}"/>
              <Setter Property="Padding" Value="10,4"/>
              <Setter Property="Cursor" Value="Hand"/>
              <Setter Property="ToolTip" Value="Turn radar on"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="RadarPillSurface" Background="{TemplateBinding Background}" CornerRadius="12"
                            Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RadarPillSurface" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RadarPillSurface" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                      <Trigger Property="IsPressed" Value="True"><Setter TargetName="RadarPillSurface" Property="Opacity" Value="0.75"/></Trigger>
                      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="RadarPillSurface" Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <DataTrigger Binding="{Binding NavigationActive}" Value="True">
                  <Setter Property="Background" Value="{StaticResource AccentDark}"/>
                  <Setter Property="ToolTip" Value="Turn radar off"/>
                </DataTrigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="ToolTip" Value="Radar unavailable or updating. Connect to Grim Dawn and wait for navigation to be ready."/></Trigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{StaticResource SecondaryText}"/>
                  <Style.Triggers><DataTrigger Binding="{Binding NavigationActive}" Value="True"><Setter Property="Fill" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock x:Name="RadarIndicatorText" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Setter Property="Text" Value="Radar Inactive"/>
                  <Style.Triggers><DataTrigger Binding="{Binding NavigationActive}" Value="True"><Setter Property="Text" Value="Radar Active"/></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Button>
        <Border x:Name="AssistStatusBadge" CornerRadius="12" Padding="10,4" Margin="0,0,8,0" Background="{StaticResource PanelRaised}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="AssistStatusDot" Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{StaticResource SecondaryText}"/>
            <TextBlock x:Name="AssistIndicatorText" Text="Assists Inactive" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <Border CornerRadius="12" Padding="10,4" Margin="0,0,8,0" VerticalAlignment="Center">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="{StaticResource PanelRaised}"/>
              <Style.Triggers><DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Background" Value="{StaticResource AccentDark}"/></DataTrigger></Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{StaticResource SecondaryText}"/>
                  <Style.Triggers><DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Fill" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding ConnectionText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource TitleBarButton}" Click="MinimizeWindow" shell:WindowChrome.IsHitTestVisibleInChrome="True" automation:AutomationProperties.Name="Minimize" automation:AutomationProperties.HelpText="Minimize Window" ToolTip="Minimize" ToolTipService.InitialShowDelay="350">
            <Viewbox Width="12" Height="12"><Path Data="M 1,9 L 11,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" StrokeStartLineCap="Square" StrokeEndLineCap="Square"/></Viewbox>
          </Button>
          <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Click="ToggleMaximize" shell:WindowChrome.IsHitTestVisibleInChrome="True" automation:AutomationProperties.Name="Maximize" automation:AutomationProperties.HelpText="Maximize Window" ToolTip="Maximize" ToolTipService.InitialShowDelay="350">
            <Viewbox Width="12" Height="12"><Path x:Name="MaximizeGlyph" Data="M 1,1 L 11,1 11,11 1,11 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.15" Fill="Transparent" StrokeLineJoin="Miter"/></Viewbox>
          </Button>
          <Button Style="{StaticResource CloseTitleBarButton}" Click="CloseWindow" shell:WindowChrome.IsHitTestVisibleInChrome="True" automation:AutomationProperties.Name="Exit" automation:AutomationProperties.HelpText="Exit GDCompanion" ToolTip="Exit" ToolTipService.InitialShowDelay="350">
            <Viewbox Width="12" Height="12"><Path Data="M 1.5,1.5 L 10.5,10.5 M 10.5,1.5 L 1.5,10.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" StrokeStartLineCap="Square" StrokeEndLineCap="Square"/></Viewbox>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#0D1728" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="18,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" MaxWidth="202">
            <TextBlock x:Name="SidebarCompanionTitle" Text="GDCompanion" FontFamily="{StaticResource SidebarBrandFont}" FontWeight="Normal" FontSize="29" Foreground="{StaticResource Accent}"/>
          </Viewbox>
          <TextBlock Text="Unofficial companion tool for Grim Dawn" Foreground="White" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
          <TextBlock x:Name="SidebarVersionText" Text="{x:Static local:AppVersion.Display}" Foreground="{StaticResource SecondaryText}" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2">
          <Button x:Name="CatalogNav" Style="{StaticResource NavButton}" Content="⌕   Item Catalog" Click="ShowCatalog" Background="{StaticResource AccentDark}"/>
          <Button x:Name="NavigationNav" Style="{StaticResource NavButton}" Content="Navigation" Click="ShowNavigation" automation:AutomationProperties.Name="Navigation">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                    <Viewbox x:Name="NavigationCompassIcon" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" IsHitTestVisible="False">
                      <Canvas Width="16" Height="16">
                        <Ellipse Canvas.Left="1" Canvas.Top="1" Width="14" Height="14" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2"/>
                        <Path Data="M 11.5,4.5 L 9.5,9.5 L 4.5,11.5 L 6.5,6.5 Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" StrokeLineJoin="Round"/>
                        <Path Data="M 11.5,4.5 L 9.5,9.5 L 6.5,6.5 Z" Fill="{TemplateBinding Foreground}"/>
                      </Canvas>
                    </Viewbox>
                    <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.88"/></Trigger>
                  <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.38"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <Button x:Name="UtilitiesNav" Style="{StaticResource NavButton}" Content="✦   Character Utilities" Click="ShowUtilities"/>
          <Button x:Name="CompatibilityNav" Style="{StaticResource NavButton}" Content="✓   Compatibility" Click="ShowCompatibility"/>
          <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Content="⚙   Settings" Click="ShowSettings"/>
        </StackPanel>
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14">
          <StackPanel>
            <DockPanel><Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Margin="0,0,8,0"/><TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold"/></DockPanel>
            <TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="46"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="28,24,30,26">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel>
        <StackPanel DockPanel.Dock="Left">
          <TextBlock x:Name="PageTitle" Text="Item Catalog" FontSize="28" FontWeight="SemiBold"/>
          <TextBlock x:Name="PageSubtitle" Text="Search installed items and deliver your selection to the loaded character." Foreground="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="ConnectButton" Style="{StaticResource PrimaryButton}" Content="Connect to Game" Click="ConnectGame"/>
        </StackPanel>
      </DockPanel>

      <ProgressBar Grid.Row="1" Value="{Binding Progress}" Maximum="100" Height="3" VerticalAlignment="Center" Background="{StaticResource PanelRaised}" Foreground="{StaticResource Accent}" BorderThickness="0"/>

      <Grid Grid.Row="2">
        <!-- Catalog -->
        <Grid x:Name="CatalogPage">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search item name, DBR path, or classification" Margin="0,0,10,0"/>
            <ComboBox x:Name="CategoryFilter" Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Margin="0,0,10,0"/>
            <ComboBox x:Name="SourceFilter" Grid.Column="2" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" Margin="0,0,14,0"/>
            <TextBlock Grid.Column="3" Text="{Binding ItemCountText}" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
          </Grid>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
              <DataGrid ItemsSource="{Binding ItemsView}" SelectedItem="{Binding SelectedItem}" SelectionMode="Single" SelectionUnit="FullRow" AutoGenerateColumns="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="ITEM" Binding="{Binding Name}" Width="2*"/>
                  <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="1.15*"/>
                  <DataGridTextColumn Header="RARITY" Binding="{Binding Classification}" Width="0.8*"/>
                  <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="1.1*"/>
                  <DataGridTextColumn Header="LEVEL" Binding="{Binding ItemLevel}" Width="70"/>
                </DataGrid.Columns>
              </DataGrid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <TextBlock Text="SELECTED ITEM" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="{Binding SelectedItem.Name, TargetNullValue=Choose an item}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,18"/>
                    <TextBlock Text="DBR Record" Foreground="{StaticResource SecondaryText}" FontSize="12"/>
                    <Border Background="#09111F" CornerRadius="7" Padding="11" Margin="0,6,0,14">
                      <TextBlock Text="{Binding SelectedItem.RecordPath}" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="Wrap"/>
                    </Border>
                    <Grid Margin="0,0,0,12">
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="Classification" Foreground="{StaticResource SecondaryText}" FontSize="12"/><TextBlock Text="{Binding SelectedItem.Classification, TargetNullValue=—}" Margin="0,4,0,0"/></StackPanel>
                      <StackPanel Grid.Column="1"><TextBlock Text="Item Level" Foreground="{StaticResource SecondaryText}" FontSize="12"/><TextBlock Text="{Binding SelectedItem.ItemLevel, TargetNullValue=—}" Margin="0,4,0,0"/></StackPanel>
                    </Grid>
                    <TextBlock Text="Prefix" Foreground="{StaticResource SecondaryText}" FontSize="12"/>
                    <ComboBox ItemsSource="{Binding PrefixChoices}" SelectedItem="{Binding SelectedPrefix}" IsEnabled="{Binding HasPrefixChoices}" IsTextSearchEnabled="True" TextSearch.TextPath="Name" MaxDropDownHeight="300" Margin="0,6,0,12" ToolTip="{Binding SelectedPrefix.Tooltip}" ItemTemplate="{StaticResource AffixChoiceTemplate}"/>
                    <TextBlock Text="Suffix" Foreground="{StaticResource SecondaryText}" FontSize="12"/>
                    <ComboBox ItemsSource="{Binding SuffixChoices}" SelectedItem="{Binding SelectedSuffix}" IsEnabled="{Binding HasSuffixChoices}" IsTextSearchEnabled="True" TextSearch.TextPath="Name" MaxDropDownHeight="300" Margin="0,6,0,12" ToolTip="{Binding SelectedSuffix.Tooltip}" ItemTemplate="{StaticResource AffixChoiceTemplate}"/>
                    <TextBlock Text="{Binding AffixHint}" Foreground="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="Quantity" Foreground="{StaticResource SecondaryText}" FontSize="12"/>
                    <TextBox x:Name="QuantityBox" Text="1" Margin="0,6,0,12"/>
                    <CheckBox x:Name="CompleteComponentBox" Content="Spawn Component Completed" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,10"/>
                    <TextBlock Text="Items are delivered to the loaded character. Single-player only." Foreground="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap"/>
                  </StackPanel>
                </ScrollViewer>
                <Button Grid.Row="1" Style="{StaticResource PrimaryButton}" Content="Spawn Selected Item" Click="SpawnItem" Margin="0,18,0,0"/>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <!-- Navigation -->
        <TabControl x:Name="NavigationPage" Visibility="Collapsed">
          <TabItem Header="Radar Overlay">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="Quest &amp; POI Radar Overlay" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="Show quest objectives and points of interest on a click-through overlay aligned with Grim Dawn's minimap." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,18"/>
                    <CheckBox x:Name="NavigationQuestBox" Content="Active Quest Objectives" IsChecked="True" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,12" Checked="NavigationFilterChanged" Unchecked="NavigationFilterChanged"/>
                    <CheckBox x:Name="NavigationPoiBox" Content="Points Of Interest" IsChecked="True" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,14" Checked="NavigationFilterChanged" Unchecked="NavigationFilterChanged"/>
                    <Expander Header="POI Type Filter" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,14" IsEnabled="{Binding IsChecked, ElementName=NavigationPoiBox}">
                      <WrapPanel x:Name="PoiTypesPanel" Margin="0,12,0,0">
                        <WrapPanel.Resources><Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource PrimaryText}"/><Setter Property="Width" Value="180"/><Setter Property="Margin" Value="0,0,8,10"/></Style></WrapPanel.Resources>
                        <CheckBox Content="Rifts &amp; travel utilities" Tag="Travel" Checked="NavigationFilterChanged" Unchecked="NavigationFilterChanged"/>
                        <CheckBox Content="Vendors" Tag="Vendors" Checked="NavigationFilterChanged" Unchecked="NavigationFilterChanged"/>
                        <CheckBox Content="Blacksmiths" Tag="Blacksmiths" Checked="NavigationFilterChanged" Unchecked="NavigationFilterChanged"/>
                        <CheckBox Content="Spirit guides" Tag="SpiritGuides" Checked="NavigationFilterChanged" Unchecked="NavigationFilterChanged"/>
                        <CheckBox Content="Smugglers" Tag="Smugglers" Checked="NavigationFilterChanged" Unchecked="NavigationFilterChanged"/>
                        <CheckBox Content="Illusionists" Tag="Illusionists" Checked="NavigationFilterChanged" Unchecked="NavigationFilterChanged"/>
                        <CheckBox Content="Devotion shrines" Tag="DevotionShrines" Checked="NavigationFilterChanged" Unchecked="NavigationFilterChanged"/>
                        <CheckBox Content="Monster shrines" Tag="MonsterShrines" Checked="NavigationFilterChanged" Unchecked="NavigationFilterChanged"/>
                        <CheckBox Content="One-shot chests" Tag="Chests" Checked="NavigationFilterChanged" Unchecked="NavigationFilterChanged"/>
                        <CheckBox Content="Lore notes" Tag="Lore" Checked="NavigationFilterChanged" Unchecked="NavigationFilterChanged"/>
                        <CheckBox Content="NPCs &amp; sites" Tag="Npcs" Checked="NavigationFilterChanged" Unchecked="NavigationFilterChanged"/>
                        <CheckBox Content="Ascension altars" Tag="AscensionAltars" Checked="NavigationFilterChanged" Unchecked="NavigationFilterChanged"/>
                        <CheckBox Content="Other POIs" Tag="Other" Checked="NavigationFilterChanged" Unchecked="NavigationFilterChanged"/>
                      </WrapPanel>
                    </Expander>
                    <CheckBox x:Name="NavigationAutomaticBox" Content="Automatically align with the game minimap" IsChecked="True" Foreground="{StaticResource PrimaryText}" Margin="0,0,0,8" Checked="NavigationAlignmentModeChanged" Unchecked="NavigationAlignmentModeChanged"/>
                    <TextBlock x:Name="NavigationAlignmentStatusText" Text="Automatically matches the minimap's position, size, zoom and rotation. No resolution preset is needed." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <Expander Header="Advanced Calibration(Not Recommended)" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,16" IsExpanded="False">
                    <StackPanel Margin="0,12,0,0">
                    <StackPanel x:Name="NavigationManualPanel" IsEnabled="False">
                    <TextBlock Text="MANUAL POSITION &amp; SIZE" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                    <TextBlock Text="Turn off automatic alignment to adjust these saved manual settings." TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,5">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                      <TextBlock Text="Horizontal" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                      <Slider x:Name="NavigationHorizontalOffsetSlider" Grid.Column="1" Minimum="-300" Maximum="300" Value="0" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="NavigationOverlaySettingChanged"/>
                      <TextBlock x:Name="NavigationHorizontalOffsetText" Grid.Column="2" Text="0 px" Foreground="{StaticResource PrimaryText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,5">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                      <TextBlock Text="Vertical" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                      <Slider x:Name="NavigationVerticalOffsetSlider" Grid.Column="1" Minimum="-300" Maximum="300" Value="0" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="NavigationOverlaySettingChanged"/>
                      <TextBlock x:Name="NavigationVerticalOffsetText" Grid.Column="2" Text="0 px" Foreground="{StaticResource PrimaryText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,9">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                      <TextBlock Text="Size" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                      <Slider x:Name="NavigationScaleSlider" Grid.Column="1" Minimum="0.6" Maximum="1.5" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="NavigationOverlaySettingChanged"/>
                      <TextBlock x:Name="NavigationScaleText" Grid.Column="2" Text="1.00×" Foreground="{StaticResource PrimaryText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Button Style="{StaticResource SecondaryButton}" Content="Reset Manual Position &amp; Size" Click="ResetNavigationOverlayAlignment" Margin="0,0,0,12"/>
                    </StackPanel>
                    <TextBlock Text="MAP DISTANCE" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="11" Margin="0,8,0,8"/>
                    <TextBlock Text="Automatic mode follows the game's minimap zoom and rotation. This range applies only to manual mode." TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,9">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                      <TextBlock Text="Range" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                      <Slider x:Name="NavigationRangeSlider" Grid.Column="1" Minimum="25" Maximum="100" Value="48" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="NavigationOverlaySettingChanged"/>
                      <TextBlock x:Name="NavigationRangeText" Grid.Column="2" Text="48 u" Foreground="{StaticResource PrimaryText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    </StackPanel>
                    </Expander>
                    <Button x:Name="NavigationToggleButton" Style="{StaticResource PrimaryButton}" Content="Enable Radar Overlay" Click="ToggleNavigationMarkers" IsEnabled="False"/>
                    <Border Background="{StaticResource PanelRaised}" CornerRadius="7" Padding="12" Margin="0,14,0,0">
                      <DockPanel>
                        <Ellipse x:Name="NavigationStatusDot" DockPanel.Dock="Left" Width="8" Height="8" Fill="{StaticResource SecondaryText}" Margin="0,2,9,0" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding NavigationStatusText}" Foreground="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap"/>
                      </DockPanel>
                    </Border>
                    <TextBlock x:Name="NavigationQuestDiagnosticsText" Foreground="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="Fullscreen-Compatible Overlay" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="Automatic mode draws markers and hover labels within Grim Dawn's interface. Alignment follows the game's resolution, interface scale and minimap each frame. The overlay hides when a supported minimap is unavailable. Manual mode use a separate overlay window. No game settings or save data are changed." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,7,0,18"/>
                    <TextBlock Text="How It Works" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="11"/>
                    <TextBlock Text="• Distant active quest objectives appear as gold direction stars beyond the POI rim.&#10;• Nearby POIs include services and travel utilities, such as boats.&#10;• Hover over a marker to identify it.&#10;• The nearest distant catalogue POIs appear at the rim to show their direction.&#10;• The overlay hides when Grim Dawn is minimized or another app has focus.&#10;• Markers clear when the overlay is disabled, Companion disconnects, or Companion closes." Foreground="{StaticResource PrimaryText}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="23"/>
                  </StackPanel>
                </Border>
              </Grid>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Position Bookmarks">
            <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border Grid.RowSpan="2" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock Text="Save Current Position" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Save a named location for use across characters, difficulties and hardcore modes when the campaign map data matches." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,18"/>
                <TextBlock Text="Bookmark Name" Foreground="{StaticResource SecondaryText}"/>
                <TextBox x:Name="PositionNameBox" Margin="0,6,0,10" MaxLength="60"/>
                <Button x:Name="SaveBookmarkButton" Style="{StaticResource PrimaryButton}" Content="Save Current Position" Click="SavePositionBookmark" IsEnabled="False"/>
                <TextBlock Text="Bookmarks are stored locally and remain available after restarting Companion or Grim Dawn." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,18,0,0"/>
                <TextBlock Text="Travel is supported between outdoor campaign areas. Bookmarks are blocked if their map data no longer matches." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <TextBlock x:Name="BookmarkAvailabilityText" Text="Connect with the current bridge to use persistent bookmarks." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,12,0,0"/>
              </StackPanel></ScrollViewer></Border>
              <Border x:Name="SharedBookmarksCard" Grid.Column="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True"><Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="18"><TextBlock Text="Shared Bookmarks" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Saved difficulty is for reference only. Any character can use a bookmark when the map data is compatible." TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" Margin="0,5,0,0"/></StackPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding PositionBookmarks}" SelectedItem="{Binding SelectedBookmark}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns>
                  <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*" MinWidth="100"/>
                  <DataGridTextColumn Header="SAVED BY" Binding="{Binding Character}" Width="*" MinWidth="90"/>
                  <DataGridTextColumn Header="DIFFICULTY" Binding="{Binding Difficulty}" Width="90"/>
                  <DataGridTextColumn Header="LOCATION" Binding="{Binding LocationDisplay}" Width="*" MinWidth="135"/>
                  <DataGridTextColumn Header="HOTKEY" Binding="{Binding HotkeyDisplay}" Width="145"/>
                  <DataGridTextColumn Header="SAVED" Binding="{Binding CreatedAt, StringFormat={}{0:g}}" Width="140"/>
                </DataGrid.Columns></DataGrid>
                <WrapPanel Grid.Row="2" Margin="18">
                  <Button x:Name="ReturnBookmarkButton" Style="{StaticResource PrimaryButton}" Content="Return to Selected Position" Click="RestorePositionBookmark" IsEnabled="False" Margin="0,0,10,8"/>
                  <Button x:Name="DeleteBookmarkButton" Style="{StaticResource SecondaryButton}" Content="Delete" Click="DeletePositionBookmark" Margin="0,0,10,8"/>
                  <Button x:Name="RefreshBookmarkNamesButton" Content="Refresh Location Names" Click="RefreshBookmarkNames" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/>
                </WrapPanel>
              </Grid></Border>
              <Border x:Name="BookmarkHotkeysCard" Grid.Column="2" Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="230"><StackPanel>
                  <TextBlock Text="Selected Bookmark Hotkeys" FontSize="19" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding SelectedBookmark.Name, StringFormat=Selected: {0}, TargetNullValue=Select a bookmark above}" FontWeight="SemiBold" Margin="0,8,0,6"/>
                  <TextBlock Text="Assign Ctrl+Alt, optionally with Shift, plus a letter, number or F1–F12. Choose a shortcut that Grim Dawn does not use; Hotkeys work only while Grim Dawn has focus and the loaded player is ready." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                <TextBlock Text="Only one bookmark return can run at a time. Returns have a two-second cooldown." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                  <TextBox x:Name="BookmarkHotkeyBox" IsReadOnly="True" Text="Press a key combination here" PreviewKeyDown="CaptureBookmarkHotkey" Margin="0,10,0,10" AutomationProperties.Name="Bookmark hotkey combination"/>
                  <WrapPanel>
                    <Button x:Name="AssignBookmarkHotkeyButton" Content="Assign Hotkey" Click="AssignBookmarkHotkey" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button x:Name="ClearBookmarkHotkeyButton" Content="Remove Hotkey" Click="ClearBookmarkHotkey" Style="{StaticResource SecondaryButton}"/>
                  </WrapPanel>
                </StackPanel></ScrollViewer>
              </Border>
            </Grid>
          </TabItem>
        </TabControl>

        <!-- Character Utilities -->
        <TabControl x:Name="UtilitiesPage" Visibility="Collapsed">
          <TabItem Header="Gameplay Assists">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,18,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="Gameplay Assists" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="Assists start off and are not carried to another character or session." TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" Margin="0,8,0,12"/>
                    <TextBlock x:Name="AssistStatusText" Text="Connect to Grim Dawn to check availability." TextWrapping="Wrap" FontWeight="SemiBold"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                  <StackPanel x:Name="AssistOptionsPanel" IsEnabled="False">
                    <CheckBox x:Name="AssistInvincibleBox" Content="Invincibility" Click="ToggleGameplayAssist" Margin="0,0,0,5"/>
                    <TextBlock Text="Uses the game's player-invincibility check. Some scripted deaths may still occur." TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" Margin="24,0,0,18"/>
                    <CheckBox x:Name="AssistEnergyBox" Content="Unlimited Energy" Click="ToggleGameplayAssist" Margin="0,0,0,5"/>
                    <TextBlock Text="Maintains available energy and bypasses normal energy use. Energy reserved by buffs remains reserved, and skills must fit within the available pool." TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" Margin="24,0,0,18"/>
                    <CheckBox x:Name="AssistCooldownBox" Content="Instant Skill Cooldown" Click="ToggleGameplayAssist" Margin="0,0,0,5"/>
                    <TextBlock Text="Clears player skill cooldowns. Casting animations and other skill requirements still apply." TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" Margin="24,0,0,18"/>
                    <CheckBox x:Name="AssistSpeedBox" Content="Movement Speed" Click="ToggleGameplayAssist" Margin="0,0,0,8"/>
                    <DockPanel Margin="24,0,0,18">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=AssistSpeedSlider, Path=Value, StringFormat={}{0:0}%}" Width="65" TextAlignment="Right" VerticalAlignment="Center"/>
                      <Slider x:Name="AssistSpeedSlider" Minimum="100" Maximum="200" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="GameplayAssistSpeedChanged" IsEnabled="{Binding ElementName=AssistSpeedBox, Path=IsChecked}" ToolTip="Changes apply automatically while Movement Speed is enabled. Attack and casting speeds are unchanged."/>
                    </DockPanel>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="Uncheck an assist to turn it off. Stopping restores normal behavior." TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Character Resources">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,18,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="Level Character" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="Raise the loaded character to the active game or mod's level cap using normal level-up rewards. Lowering levels is not supported. Remove bonus-XP equipment, and back up the character before continuing." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                    <TextBlock x:Name="CharacterLevelCapText" Text="Connect and refresh to read the active level cap." Foreground="{StaticResource SecondaryText}" Margin="0,0,0,10"/>
                    <DockPanel><Button x:Name="SetCharacterLevelButton" DockPanel.Dock="Right" Content="Level Character" Click="SetCharacterLevel" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"/><TextBox x:Name="CharacterLevelBox" Text="" MaxLength="4" AutomationProperties.Name="Target character level within the active game or mod cap"/></DockPanel>
                    <TextBlock x:Name="CharacterLevelStatusText" Text="Companion checks the loaded character before asking you to confirm. No changes are made until you confirm." TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" Margin="0,12,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource SecondaryButton}" Content="Refresh Values" Click="RefreshCharacterResources"/>
                    <StackPanel><TextBlock Text="Current Character Resources" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Set money or an unspent point balance. Active mod rules take priority; otherwise, installed game and DLC rules apply. Allocated points count toward the full endgame limit and are not changed." Foreground="{StaticResource SecondaryText}" Margin="0,6,20,0" TextWrapping="Wrap"/>
                      <CheckBox x:Name="ResourceCapBypassBox" Content="Natural Cap Bypass" Foreground="{StaticResource PrimaryText}" Margin="0,16,0,8" Checked="ResourceCapBypassChanged" Unchecked="ResourceCapBypassChanged"/>
                      <TextBlock Text="Optional and session-only. Allows up to 10,000 total points per pool, or the active mod's higher limit. Money, character-level and individual skill-rank limits are unchanged. Though hard safety caps are in place, above-cap save and mod compatibility is not guaranteed. Use with caution." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,20,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
                <WrapPanel>
                  <Border Style="{StaticResource Card}" Width="240" Margin="0,0,14,14"><StackPanel><TextBlock Text="Money" Foreground="{StaticResource SecondaryText}"/><TextBlock Text="{Binding MoneyText}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,14"/><TextBlock x:Name="MoneyLimitText" Text="Refresh to read the limit." TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,10"/><TextBox x:Name="MoneyAmountBox" Text="" AutomationProperties.Name="Desired money balance"/><Button Style="{StaticResource PrimaryButton}" Content="Set Money" Tag="money" Click="SetCharacterResource" Margin="0,10,0,0"/></StackPanel></Border>
                  <Border Style="{StaticResource Card}" Width="240" Margin="0,0,14,14"><StackPanel><TextBlock Text="Unspent Skill Points" Foreground="{StaticResource SecondaryText}"/><TextBlock Text="{Binding SkillPointsText}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,14"/><TextBlock x:Name="SkillLimitText" Text="Refresh to read the limit." TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,10"/><TextBox x:Name="SkillAmountBox" Text="" AutomationProperties.Name="Desired unspent skill points"/><Button Style="{StaticResource PrimaryButton}" Content="Set Skill Points" Tag="skill" Click="SetCharacterResource" Margin="0,10,0,0"/></StackPanel></Border>
                  <Border Style="{StaticResource Card}" Width="240" Margin="0,0,14,14"><StackPanel><TextBlock Text="Unspent Attribute Points" Foreground="{StaticResource SecondaryText}"/><TextBlock Text="{Binding AttributePointsText}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,14"/><TextBlock x:Name="AttributeLimitText" Text="Refresh to read the limit." TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,10"/><TextBox x:Name="AttributeAmountBox" Text="" AutomationProperties.Name="Desired unspent attribute points"/><Button Style="{StaticResource PrimaryButton}" Content="Set Attribute Points" Tag="attribute" Click="SetCharacterResource" Margin="0,10,0,0"/></StackPanel></Border>
                  <Border Style="{StaticResource Card}" Width="240" Margin="0,0,14,14"><StackPanel><TextBlock Text="Unspent Devotion Points" Foreground="{StaticResource SecondaryText}"/><TextBlock Text="{Binding DevotionPointsText}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,14"/><TextBlock x:Name="DevotionLimitText" Text="Refresh to read the limit." TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,10"/><TextBox x:Name="DevotionAmountBox" Text="" AutomationProperties.Name="Desired unspent devotion points"/><Button Style="{StaticResource PrimaryButton}" Content="Set Devotion Points" Tag="devotion" Click="SetCharacterResource" Margin="0,10,0,0"/></StackPanel></Border>
                </WrapPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Mastery Respec">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,18,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="Mastery Respec" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="Respec Character checks the loaded character and prepares a refund for your confirmation. After a verified respec, choose new masteries in the game's skill window." TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" Margin="0,8,0,12"/>
                    <TextBlock x:Name="MasteryAuditConnection" Text="Connect to Grim Dawn to inspect the loaded character." TextWrapping="Wrap" Margin="0,0,0,12"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                  <TextBlock x:Name="MasteryAuditResult" Text="No character checked yet. Select Respec Character to inspect the loaded character and review the confirmation." TextWrapping="Wrap" LineHeight="24"/>
                </Border>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="Respec Character" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Before you respec" Foreground="{StaticResource SecondaryText}" Margin="0,8,0,4"/>
                    <DockPanel Margin="8,0,0,4">
                      <TextBlock Text="•" Foreground="{StaticResource SecondaryText}" Margin="0,0,8,0"/>
                      <TextBlock Text="Back up your character. Keep a separate, restorable copy; cloud saving is not a backup." TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}"/>
                    </DockPanel>
                    <DockPanel Margin="8,0,0,4">
                      <TextBlock Text="•" Foreground="{StaticResource SecondaryText}" Margin="0,0,8,0"/>
                      <TextBlock Text="Remove any equipped items that grant skills." TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}"/>
                    </DockPanel>
                    <DockPanel Margin="8,0,0,0">
                      <TextBlock Text="•" Foreground="{StaticResource SecondaryText}" Margin="0,0,8,0"/>
                      <TextBlock Text="Open the Skills page once for the loaded character." TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}"/>
                    </DockPanel>
                    <TextBlock Text="Refunds devotion points, removes devotion bindings, refunds skill and mastery-bar points, then clears both selected masteries. Celestial-power experience is retained. Requires a living single-player character outside combat, no item-granted skills, and point totals that match the inspection." TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" Margin="0,8,0,12"/>
                    <CheckBox x:Name="MasteryResetAcknowledgementBox" Content="I understand this changes the loaded character and has no guaranteed rollback." Checked="MasteryResetAcknowledgementChanged" Unchecked="MasteryResetAcknowledgementChanged" Margin="0,0,0,12"/>
                    <WrapPanel>
                      <Button x:Name="MasteryReplaceButton" Style="{StaticResource PrimaryButton}" Content="Respec Character" IsEnabled="False" Click="PrepareMasteryReset" Margin="0,0,12,0"/>
                      <Button x:Name="MasteryOutcomeButton" Style="{StaticResource SecondaryButton}" Content="Check Last Transaction" IsEnabled="False" Click="CheckMasteryResetOutcome"/>
                    </WrapPanel>
                    <TextBlock x:Name="MasteryResetResult" Text="No reset attempted." TextWrapping="Wrap" Margin="0,12,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Blueprints">
            <Grid Margin="0,18,0,0">
              <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel Margin="18"><TextBlock Text="Crafting Blueprints" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Search installed recipes and spawn a blueprint. Use it from the character's inventory to learn it." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,5,0,12"/><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding BlueprintCountText}" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="10,0,0,0"/><TextBox Text="{Binding BlueprintSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search blueprints"/></DockPanel></StackPanel>
                  <DataGrid Grid.Row="1" ItemsSource="{Binding BlueprintsView}" SelectedItem="{Binding SelectedBlueprint}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="BLUEPRINT" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="*"/></DataGrid.Columns></DataGrid>
                  <StackPanel Grid.Row="2" Margin="18"><TextBlock Text="{Binding SelectedBlueprint.RecordPath}" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap"/><Button Style="{StaticResource PrimaryButton}" Content="Spawn Selected Blueprint" Click="SpawnBlueprint" Margin="0,12,0,0"/></StackPanel>
                </Grid>
              </Border>
            </Grid>
          </TabItem>

          <TabItem Header="Quest-Token Inspector">
            <Grid Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition/></Grid.RowDefinitions>
              <Border Style="{StaticResource Card}"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding TokenCountText}" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="12,0,0,0"/><StackPanel><TextBlock Text="Installed Quest Tokens" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Warning: Quest-token changes can permanently break quests or character progression. Change only states you understand. Search for a quest token to inspect or change its state." TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" Margin="0,5,0,12"/><TextBox Text="{Binding TokenSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search token name or source"/></StackPanel></DockPanel></Border>
              <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True"><DataGrid ItemsSource="{Binding QuestTokensView}" SelectedItem="{Binding SelectedToken}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="TOKEN" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="*"/><DataGridTextColumn Header="REFERENCES" Binding="{Binding References}" Width="95"/></DataGrid.Columns></DataGrid></Border>
                <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="SELECTED TOKEN" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="11"/><TextBlock Text="{Binding SelectedToken.Name, TargetNullValue=Choose a token}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,9,0,16"/><TextBlock Text="Character State" Foreground="{StaticResource SecondaryText}"/><TextBlock Text="{Binding TokenState}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,16"/><Button Style="{StaticResource SecondaryButton}" Content="Check Token" Click="CheckQuestToken"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Style="{StaticResource PrimaryButton}" Content="Grant Token" Tag="grant" Click="SetQuestToken" Margin="0,0,5,0"/><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Remove Token" Tag="remove" Click="SetQuestToken" Margin="5,0,0,0"/></Grid><TextBlock Text="Changes require confirmation. Quest tokens depend on one another; back up the character before editing them." Foreground="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0"/></StackPanel></Border>
              </Grid>
            </Grid>
          </TabItem>

        </TabControl>

        <!-- Compatibility -->
        <Grid x:Name="CompatibilityPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Export-Based Patch Verification" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Required game functions are checked by name. Addresses and file checks update automatically when the game files change." Foreground="{StaticResource SecondaryText}" Margin="0,7,20,0" TextWrapping="Wrap"/></StackPanel>
              <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding Compatibility.Level}" Foreground="{StaticResource Accent}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock Text="{Binding Compatibility.VerifiedAt, StringFormat={}{0:g}}" Foreground="{StaticResource SecondaryText}" FontSize="11"/></StackPanel>
            </Grid>
          </Border>
          <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Symbols}" AutoGenerateColumns="False">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="OK" Binding="{Binding Found}" Width="55"/>
                <DataGridTextColumn Header="MODULE" Binding="{Binding Module}" Width="95"/>
                <DataGridTextColumn Header="SYMBOL" Binding="{Binding FriendlyName}" Width="1.4*"/>
                <DataGridTextColumn Header="RVA" Binding="{Binding Rva, StringFormat=X}" Width="95"/>
                <DataGridTextColumn Header="SECTION" Binding="{Binding Section}" Width="85"/>
                <DataGridTextColumn Header="RESULT" Binding="{Binding Message}" Width="2*"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </Grid>

        <!-- Settings -->
        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Style="{StaticResource Card}" MaxWidth="850" HorizontalAlignment="Left">
            <StackPanel>
              <TextBlock Text="Game Installation" FontSize="19" FontWeight="SemiBold"/>
              <TextBlock Text="Your Steam installation is detected automatically. Choose a folder only if the correct installation was not found." Foreground="{StaticResource SecondaryText}" Margin="0,7,0,16" TextWrapping="Wrap"/>
              <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Choose Folder" Click="ChooseGameFolder" Margin="12,0,0,0"/><TextBox Text="{Binding GameDirectory}" IsReadOnly="True"/></DockPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" MaxWidth="850" HorizontalAlignment="Left" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="Companion Data" FontSize="19" FontWeight="SemiBold"/>
              <TextBlock Text="Rebuild the item catalogue and refresh compatibility, quest and navigation data from the installed game files. This may take some time." Foreground="{StaticResource SecondaryText}" Margin="0,7,0,14" TextWrapping="Wrap"/>
              <Button x:Name="ForceRefreshDataButton" Style="{StaticResource SecondaryButton}" Content="Force Refresh Data" Click="RefreshData" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" MaxWidth="850" HorizontalAlignment="Left" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="Safety Model" FontSize="19" FontWeight="SemiBold"/>
              <TextBlock Text="Companion does not modify game archives. Catalogue updates only read installed data. The bridge loads on demand, communicates through a local Windows pipe and runs actions on the game's update thread. It has no stealth, persistence, networking or multiplayer support. Character-changing tools can still affect saves." Foreground="{StaticResource SecondaryText}" Margin="0,7,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" MaxWidth="850" HorizontalAlignment="Left" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="Bridge Lifecycle" FontSize="19" FontWeight="SemiBold"/>
              <TextBlock Text="Companion can remove its update-thread hook and unload the bridge when closing, allowing the companion to reconnect without restarting Grim Dawn when unloading succeeds." Foreground="{StaticResource SecondaryText}" Margin="0,7,0,14" TextWrapping="Wrap"/>
              <CheckBox x:Name="AutoUnbridgeBox" Content="Automatically Unload Bridge When Closing" IsChecked="True" Foreground="{StaticResource PrimaryText}" Checked="AutoUnbridgeChanged" Unchecked="AutoUnbridgeChanged"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" MaxWidth="850" HorizontalAlignment="Left" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="License &amp; Notices" FontSize="19" FontWeight="SemiBold"/>
              <TextBlock Text="GDCompanion is an unofficial community tool for Grim Dawn. Not affiliated with or endorsed by Crate Entertainment." Foreground="{StaticResource SecondaryText}" Margin="0,7,0,0" TextWrapping="Wrap"/>
              <TextBlock Text="GPLv3 — Copyright © 2026 BunniBranch and contributors. No warranty. You may modify and redistribute this software under GPLv3." Foreground="{StaticResource SecondaryText}" Margin="0,7,0,14" TextWrapping="Wrap"/>
              <WrapPanel>
                <Button Style="{StaticResource SecondaryButton}" Content="View License" Tag="LICENSE" Click="OpenLicenseNotice" Margin="0,0,12,0"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Third-Party Notices" Tag="THIRD-PARTY-NOTICES.md" Click="OpenLicenseNotice"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
    </Grid>
  </Grid>
</Window>
