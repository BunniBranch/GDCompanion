<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>GDCompanion</AssemblyName>
    <Version>2.3.91</Version>
    <Product>GDCompanion</Product>
    <Authors>BunniBranch</Authors>
    <Company>BunniBranch</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\GrimDawnCompanion.ico')">Assets\GrimDawnCompanion.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\LICENSE;..\..\COPYRIGHT.md;..\..\THIRD-PARTY-NOTICES.md">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\ThirdParty\minhook\LICENSE.txt" Link="MINHOOK-LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <ProjectReference Include="..\GrimDawnCompanion.Core\GrimDawnCompanion.Core.csproj" />
    <Resource Include="Assets\WardenLantern-titlebar.png" Condition="Exists('Assets\WardenLantern-titlebar.png')" />
    <Resource Include="Assets\Fonts\PirataOne-Regular.ttf" />
    <Content Include="Assets\Fonts\OFL.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- Generated game data must never be embedded or distributed. -->
    <None Remove="Data\**" />
    <Content Remove="Data\**" />
    <Resource Remove="Data\**" />
    <EmbeddedResource Remove="Data\**" />
  </ItemGroup>
</Project>
