<Window x:Class="GrimDawnCompanion.App.NavigationOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1" Height="1" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" ResizeMode="NoResize" Focusable="False">
  <!-- This window covers the game client, but every pixel except the small
       glyphs below remains transparent and click-through. -->
  <Canvas x:Name="OverlayCanvas" Background="Transparent" IsHitTestVisible="False">
    <Ellipse x:Name="GuideRing" Fill="Transparent" Stroke="#A042E8C6"
             StrokeThickness="1.5" StrokeDashArray="2,5"/>
    <Canvas x:Name="MarkerCanvas" IsHitTestVisible="False"/>
    <Path x:Name="PlayerMarker" Data="M 0,-9 L 7,8 L 0,5 L -7,8 Z"
          Fill="#FF42E8C6" Stroke="#E008111D" StrokeThickness="1.25"
          Stretch="Fill"/>
    <Border x:Name="HoverTooltip" Visibility="Collapsed" IsHitTestVisible="False"
            Panel.ZIndex="20" Background="#F20B1424" BorderBrush="#CC42E8C6"
            BorderThickness="1" CornerRadius="7" Padding="10,7" MaxWidth="270">
      <StackPanel>
        <TextBlock x:Name="HoverTitle" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
        <TextBlock x:Name="HoverDetail" Foreground="#FFC2CCDC" FontSize="11"
                   Margin="0,2,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
  </Canvas>
</Window>
